# Copy to .env (or export these variables) before starting the server.

# HTTP port and bind address. The server listens on 0.0.0.0 by default so the preview can reach it.
PORT=3000
HOST=0.0.0.0

# SQLite database file. Created automatically; the directory must exist.
DATABASE_PATH=data/undead-slayer.db

# Set to true when serving over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false

# Session lifetime in days.
SESSION_DAYS=14

# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
