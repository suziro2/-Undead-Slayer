{
  "name": "undead-slayer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pixel-art 2D action RPG with accounts, gacha, and 50 campaign levels",
  "main": "server/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
