    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "express": "^5.3.0",
    "phaser": "^3.90.0"
  }
}